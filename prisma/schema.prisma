// Prisma schema mapped to existing PostgreSQL tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  role         String   @default("REP") // ADMIN, REP, INSPECTOR, CUSTOMER
  contractorId BigInt?  @map("contractor_id")
  customerId   BigInt?  @map("customer_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)

  sessions             Session[]
  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  passwordResets       PasswordReset[]
  invitesSent          Invite[]          @relation("owner_invites")
  assignments          Assignment[]      @relation("AssignedCrew")
  ownerAssignments     Assignment[]      @relation("OwnerAssignments")
  estimatorAssignments Assignment[]      @relation("EstimatorAssignments")
  inspections          LeadInspection[]  @relation("PerformedInspections")
  watchlistLeadIds     BigInt[]          @map("watchlist_lead_ids") @db.BigInt


  messagesSent      Message[]        @relation("SentMessages")
  messagesReceived  Message[]        @relation("ReceivedMessages")
  chatParticipants  ChatParticipant[]
  
  // Job relations
  jobStatusHistory  JobStatusHistory[] @relation("JobStatusHistory")
  jobNotes          JobNote[]          @relation("JobNotes")
  jobFeedItems      JobFeedItem[]      @relation("JobFeedItems")
  jobTodosCreated   JobTodo[]          @relation("JobTodosCreated")
  jobTodosCompleted JobTodo[]           @relation("JobTodosCompleted")
  invoicesCreated   Invoice[]           @relation("CreatedInvoices")
  jobParticipants   JobParticipant[]    @relation("JobParticipants")
  
  @@map("users")
}

model Session {
  id        String   @id
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model Customer {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?  @unique
  phone        String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  postalCode   String?  @map("postal_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  leads     Lead[]
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]
  users     User[]

  @@map("customers")
}

model Lead {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  customerId  BigInt?  @map("customer_id")
  title       String
  description String?
  status      String   @default("new") // new, contacted, qualified, inspection_scheduled, estimate_sent, proposal_sent, job_created, closed
  source      String? // Website, Referral, Google Ads, etc.
  priority    String? // low, medium, high
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobs        Job[]
  inspections LeadInspection[]
  assignments Assignment[]
  estimates   Estimate[]

  @@index([customerId])
  @@map("leads")
}

model Assignment {
  id                  BigInt    @id @default(autoincrement()) @db.BigInt
  leadId              BigInt    @map("lead_id")
  assignedToId        BigInt    @map("assigned_to_id") // sales rep or user handling lead
  ownerId             BigInt    @map("owner_id") // contractor or admin assigning
  estimatorId         BigInt?   @map("estimator_id") // optional estimator assigned
  role                String? // "Sales Rep", "Inspector", etc.
  status              String    @default("assigned") // assigned, in_contact, inspection_scheduled, estimate_sent, proposal_sent, job_created, closed
  lastStatusChangedAt DateTime? @map("last_status_changed_at") @db.Timestamptz(6)

  // Minimal "current" data for quick reference
  inspectionDate   DateTime? @map("inspection_date") @db.Timestamptz(6)
  latestEstimateId BigInt?   @map("latest_estimate_id")
  latestProposalId BigInt?   @map("latest_proposal_id")
  latestJobId      BigInt?   @map("latest_job_id")

  // Compact history of all events (status changes, inspection, estimate, proposal, etc.)
  history Json @default("[]")

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User       @relation("AssignedCrew", fields: [assignedToId], references: [id], onDelete: Cascade)
  owner      User       @relation("OwnerAssignments", fields: [ownerId], references: [id], onDelete: Cascade)
  estimator  User?      @relation("EstimatorAssignments", fields: [estimatorId], references: [id], onDelete: SetNull)
  docs       Docs[]
  estimates  Estimate[]
  jobs       Job[]
  proposals  Proposal[]

  @@index([leadId])
  @@index([assignedToId])
  @@index([ownerId])
  @@index([estimatorId])
  @@map("assignments")
}

model Docs {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  assignmentId BigInt   @map("assignment_id")
  docs         Json // array of file references or metadata
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("docs")
}

// DraftEstimate model removed; using Estimate with status instead

model LeadInspection {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  leadId        BigInt    @map("lead_id")
  inspectorId   BigInt?   @map("inspector_id")
  scheduledDate DateTime? @map("scheduled_date") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  result        String? // Pass, Fail, Needs Repair
  notes         String?
  photos        String[] // array of image URLs
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  inspector User?      @relation("PerformedInspections", fields: [inspectorId], references: [id], onDelete: SetNull)
  estimates Estimate[]

  @@index([leadId])
  @@index([inspectorId])
  @@map("lead_inspections")
}

model Job {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  customerId    BigInt    @map("customer_id")
  leadId        BigInt?   @map("lead_id")
  assignmentId  BigInt?   @map("assignment_id")
  title         String
  description   String?
  status        String    @default("scheduled") // scheduled, in_progress, completed, canceled
  priority      String?   @default("medium") // low, medium, high
  progress      Int       @default(0) // 0-100 percentage
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  crewDetails   String? @map("crew_details") // e.g., "Crew A - 4 members"
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  estimates Estimate[]
  invoices  Invoice[]
  statusHistory JobStatusHistory[]
  notes     JobNote[]
  feedItems JobFeedItem[]
  todos     JobTodo[]
  participants JobParticipant[]

  @@index([customerId])
  @@index([leadId])
  @@index([assignmentId])
  @@map("jobs")
}

model JobParticipant {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  jobId     BigInt   @map("job_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation("JobParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@map("job_participants")
}

model Estimate {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  customerId   BigInt    @map("customer_id")
  leadId       BigInt?   @map("lead_id")
  inspectionId BigInt?   @map("inspection_id")
  jobId        BigInt?   @map("job_id")
  assignmentId BigInt?   @map("assignment_id")
  details      Json?
  status       String    @default("draft") // draft, leading, saved, sent, viewed, accepted, rejected
  validUntil   DateTime? @map("valid_until") @db.Date
  subtotal     Decimal   @default(0) @db.Decimal(12, 2)
  taxRate      Decimal?  @default(0) @db.Decimal(5, 2)
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  inspection LeadInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  job        Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignment Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  items      EstimateItem[]
  proposal   Proposal?
  invoices   Invoice[]

  @@index([customerId])
  @@index([leadId])
  @@index([inspectionId])
  @@index([jobId])
  @@index([assignmentId])
  @@map("estimates")
}

model EstimateItem {
  id          BigInt  @id @default(autoincrement()) @db.BigInt
  estimateId  BigInt  @map("estimate_id")
  name        String
  description String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_items")
}

model Proposal {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  assignmentId  BigInt    @map("assignment_id")
  estimateId    BigInt    @unique @map("estimate_id")
  subject       String?
  content       String?
  status        String    @default("draft") // draft, sent, viewed, signed, declined
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  viewedAt      DateTime? @map("viewed_at") @db.Timestamptz(6)
  signedAt      DateTime? @map("signed_at") @db.Timestamptz(6)
  signatureUrl  String?
  clientNotes   String?
  internalNotes String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("proposals")
}

model Invoice {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  customerId  BigInt    @map("customer_id")
  jobId       BigInt?   @map("job_id")
  estimateId  BigInt?   @map("estimate_id")
  createdById BigInt?   @map("created_by_id") // Sales rep or owner who created it
  status      String    @default("draft") // draft, sent, paid, overdue, void
  invoiceNumber String? @map("invoice_number") // Unique invoice number
  dueDate     DateTime? @map("due_date") @db.Date
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  taxRate     Decimal?  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  estimate Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([customerId])
  @@index([jobId])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt  @id @default(autoincrement()) @db.BigInt
  invoiceId   BigInt  @map("invoice_id")
  name        String
  description String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model JobStatusHistory {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  jobId       BigInt    @map("job_id")
  status      String    // Custom status title
  description String?
  addedById   BigInt    @map("added_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  addedBy User @relation("JobStatusHistory", fields: [addedById], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([addedById])
  @@map("job_status_history")
}

model JobNote {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  jobId     BigInt    @map("job_id")
  content   String
  createdById BigInt  @map("created_by_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User @relation("JobNotes", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdById])
  @@map("job_notes")
}

model JobFeedItem {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  jobId       BigInt    @map("job_id")
  type        String    // message, todo_created, todo_completed, status_update
  content     String?
  createdById BigInt    @map("created_by_id")
  taggedUserIds BigInt[] @map("tagged_user_ids") @db.BigInt // Array of user IDs tagged
  metadata    Json?     // Additional data (e.g., todo reference)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User @relation("JobFeedItems", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdById])
  @@map("job_feed_items")
}

model JobTodo {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  jobId       BigInt    @map("job_id")
  title       String
  description String?
  assignedToIds BigInt[] @map("assigned_to_ids") @db.BigInt // Array of user IDs
  completed   Boolean   @default(false)
  completedById BigInt?  @map("completed_by_id")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  dueDate    DateTime? @map("due_date") @db.Timestamptz(6)
  createdById BigInt    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User @relation("JobTodosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  completedBy User? @relation("JobTodosCompleted", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdById])
  @@index([completedById])
  @@map("job_todos")
}

model Payment {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  invoiceId BigInt   @map("invoice_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String?
  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model PasswordReset {
  token     String    @id
  userId    BigInt    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Invite {
  token        String    @id
  ownerId      BigInt    @map("owner_id")
  contractorId BigInt    @map("contractor_id")
  email        String
  name         String?
  phone        String?
  role         String    @default("REP")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner User @relation("owner_invites", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([contractorId])
  @@map("invites")
}

model Chat {
  id           BigInt           @id @default(autoincrement()) @db.BigInt
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     Message[]
  participants ChatParticipant[]
}

model ChatParticipant {
  id      BigInt @id @default(autoincrement()) @db.BigInt
  userId  BigInt
  chatId  BigInt
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

model Message {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  chatId     BigInt
  senderId   BigInt
  receiverId BigInt
  content    String
  createdAt  DateTime @default(now())

  chat     Chat  @relation(fields: [chatId], references: [id])
  sender   User  @relation("SentMessages", fields: [senderId], references: [id])
  receiver User  @relation("ReceivedMessages", fields: [receiverId], references: [id])
}
// Prisma schema mapped to existing PostgreSQL tables

generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

model User {
    id           BigInt     @id @default(autoincrement()) @db.BigInt
    email        String     @unique
    passwordHash String     @map("password_hash")
    firstName    String?    @map("first_name")
    lastName     String?    @map("last_name")
    role         String     @default("REP")
    customerId   BigInt?    @map("customer_id")
    createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

    sessions     Session[]
    customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
    passwordResets PasswordReset[]

    @@map("users")
}

model Session {
    id        String    @id
    userId    BigInt    @map("user_id")
    expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], map: "sessions_user_id_idx")
    @@index([expiresAt], map: "sessions_expires_at_idx")
    @@map("sessions")
}

model Customer {
	id            BigInt      @id @default(autoincrement()) @db.BigInt
	firstName     String      @map("first_name")
	lastName      String      @map("last_name")
	email         String?     @unique
	phone         String?
	addressLine1  String?     @map("address_line1")
	addressLine2  String?     @map("address_line2")
	city          String?
	state         String?
	postalCode    String?     @map("postal_code")
	createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

	leads         Lead[]
	jobs          Job[]
	estimates     Estimate[]
	invoices      Invoice[]
    users        User[]

	@@map("customers")
}

model Lead {
	id          BigInt    @id @default(autoincrement()) @db.BigInt
	customerId BigInt?   @map("customer_id")
	title       String
	description String?
	status      String     @default("new")
	source      String?
	createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

	customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
	jobs       Job[]

	@@index([customerId], map: "leads_customer_id_idx")
	@@map("leads")
}

model Job {
	id           BigInt    @id @default(autoincrement()) @db.BigInt
	customerId  BigInt    @map("customer_id")
	leadId      BigInt?   @map("lead_id")
	title        String
	description  String?
	status       String    @default("scheduled")
	scheduledDate DateTime? @map("scheduled_date") @db.Date
	startDate     DateTime? @map("start_date") @db.Date
	endDate       DateTime? @map("end_date") @db.Date
	createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

	customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
	lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
	estimates Estimate[]
	invoices  Invoice[]

	@@index([customerId], map: "jobs_customer_id_idx")
	@@index([leadId], map: "jobs_lead_id_idx")
	@@map("jobs")
}

model Estimate {
	id          BigInt     @id @default(autoincrement()) @db.BigInt
	customerId BigInt     @map("customer_id")
	jobId      BigInt?    @map("job_id")
	status     String     @default("draft")
	validUntil DateTime?  @map("valid_until") @db.Date
	totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
	createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

	customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
	job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
	items    EstimateItem[]
	proposal Proposal?
	invoices Invoice[]

	@@index([customerId], map: "estimates_customer_id_idx")
	@@index([jobId], map: "estimates_job_id_idx")
	@@map("estimates")
}

model EstimateItem {
	id         BigInt   @id @default(autoincrement()) @db.BigInt
	estimateId BigInt   @map("estimate_id")
	name       String
	description String?
	quantity    Decimal  @default(1) @db.Decimal(12, 2)
	unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
	total       Decimal  @default(0) @db.Decimal(12, 2)

	estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

	@@index([estimateId], map: "estimate_items_estimate_id_idx")
	@@map("estimate_items")
}

model Proposal {
	id         BigInt    @id @default(autoincrement()) @db.BigInt
	estimateId BigInt    @unique @map("estimate_id")
	content    String?
	status     String    @default("draft")
	signedAt   DateTime? @map("signed_at") @db.Timestamptz(6)
	createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

	estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

	@@map("proposals")
}

model Invoice {
	id          BigInt    @id @default(autoincrement()) @db.BigInt
	customerId BigInt    @map("customer_id")
	jobId      BigInt?   @map("job_id")
	estimateId BigInt?   @map("estimate_id")
	status     String    @default("draft")
	dueDate    DateTime? @map("due_date") @db.Date
	totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
	createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
	updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

	customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
	job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
	estimate Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
	payments Payment[]

	@@index([customerId], map: "invoices_customer_id_idx")
	@@index([jobId], map: "invoices_job_id_idx")
	@@map("invoices")
}

model Payment {
	id        BigInt    @id @default(autoincrement()) @db.BigInt
	invoiceId BigInt    @map("invoice_id")
	amount    Decimal   @db.Decimal(12, 2)
	method    String?
	paidAt    DateTime  @default(now()) @map("paid_at") @db.Timestamptz(6)
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

	invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

	@@index([invoiceId], map: "payments_invoice_id_idx")
	@@map("payments")
}


model PasswordReset {
    token      String    @id
    userId     BigInt    @map("user_id")
    expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
    usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
    createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], map: "password_resets_user_id_idx")
    @@map("password_resets")
}

